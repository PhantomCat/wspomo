# wspomo environment — copy as `.env` (gitignored) and set per environment.

# Which image the wspomo container runs. Compose never builds:
# dev:  docker build -t wspomo:local .   (then IMAGE stays default)
# prod: docker pull ghcr.io/phantomcat/wspomo:latest
IMAGE=wspomo:local

# caddy external port mapping (single compose, env decides the mode):
# dev:  3000:3000 (no TLS; https mapped to a dormant high port)
# prod: 80:80 (and 443:443 below)
CADDY_HTTP=3000:3000
CADDY_HTTPS=3001:443

# Postgres credentials (generate a strong one on prod, never the default)
POSTGRES_PASSWORD=wspomo